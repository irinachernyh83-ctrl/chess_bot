# Токен от @BotFather
BOT_TOKEN=123456789:AA...your_token_here

# Куда складывать базу с партиями (необязательно)
# DB_PATH=data/chess.db

# Куда складывать файл сессии Telethon (необязательно)
# SESSION_PATH=data/chessbot

# MTProto-прокси от Telegram (необязательно, нужен если Telegram заблокирован)
# Формат: host:port:secret
# MTPROXY=127.0.0.1:1443:ddd679ffccb700620137894314c5e36162

# SOCKS5/HTTP-прокси вместо MTProto (необязательно)
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_URL=http://user:pass@127.0.0.1:8080

# Через сколько секунд удалять оконченные партии и их доски (0 — не удалять)
# FINISHED_GAME_TTL=600

# HTTP-порт для проверки живости сервиса (Render, Koyeb, PaaS).
# На обычном сервере/телефоне не нужен. Render подставляет PORT сам.
# HEALTH_PORT=8080
